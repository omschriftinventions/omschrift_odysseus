# Optional Windows Authenticode signing for Omschrift Odysseus installers.
#
# SmartScreen "Windows protected your PC" / "Run anyway" appears because the
# installer is unsigned. Metadata alone (publisher name) does not remove it.
# You need a code signing certificate from a trusted CA.
#
# 1. Purchase an OV or EV code signing certificate (e.g. DigiCert, Sectigo, SSL.com).
# 2. Install the certificate into the Windows certificate store (Current User or Local Machine).
# 3. Find the SHA1 thumbprint:
#      Get-ChildItem Cert:\CurrentUser\My | Format-List Subject, Thumbprint
# 4. Set env vars and rebuild:
#      $env:TAURI_SIGNING_CERT_THUMBPRINT = "YOUR_SHA1_THUMBPRINT"
#      $env:TAURI_SIGNING_TIMESTAMP_URL = "http://timestamp.digicert.com"
#      powershell -ExecutionPolicy Bypass -File .\build-native-windows.ps1
#
# EV certificates typically get SmartScreen trust faster than OV.
# New OV-signed apps may still show a warning until reputation builds.
